# CoDesignFlo team box: settings. Copy to .env, then fill the secrets:
#
#   cp .env.example .env
#   node scripts/generate-keys.mjs      # writes every empty secret below into .env (keeps ones already set)
#
# Keep .env private and backed up (scripts/backup.sh copies it): losing JWT_SECRET signs everyone out and makes the
# keys stop working; losing POSTGRES_PASSWORD locks you out of your own database.

############ Address ############

# The box's public address, as people and the Figma plugin reach it. No trailing slash.
#   http://localhost:8080            trying it on your machine
#   https://design.acme.com          a real box (Figma's plugin needs https outside localhost)
# Everything lives on this one origin: the web app, the MCP (<PUBLIC_URL>/mcp) and Supabase's API
# (<PUBLIC_URL>/auth/v1, /rest/v1, /storage/v1, /realtime/v1).
PUBLIC_URL=http://localhost:8080

# What the entry (Caddy) listens as.
#   :8080                            plain HTTP on HTTP_PORT (localhost, or behind your own TLS proxy/load balancer)
#   design.acme.com                  Caddy gets an HTTPS certificate itself: set PUBLIC_URL=https://design.acme.com,
#                                    and in docker-compose.yml publish ports 80 and 443 (instead of HTTP_PORT)
SITE_ADDRESS=:8080
# The host port for plain HTTP (SITE_ADDRESS=:8080).
HTTP_PORT=8080

############ Who may sign up ############

# The first account needs SETUP_CODE (below; generate-keys.mjs makes it) and becomes the box's admin. After that,
# only people invited to a project may make an account: with the invitation's sign-up code, unless the box confirms
# email addresses (SMTP and EMAIL_AUTOCONFIRM=false), where the invited email is enough.
# With email confirmation only: anyone whose email is in one of these domains (comma-separated, e.g. acme.com,acme.io).
ALLOWED_DOMAINS=

############ Email (optional) ############

# Without SMTP the box works, but sends no emails: accounts are confirmed at sign-up (EMAIL_AUTOCONFIRM=true), you
# pass invitations on yourself (with their sign-up code), notifications show in the plugin and the web app (and Slack).
# With SMTP (e.g. Gmail: smtp.gmail.com, 465, an app password), it sends invitations and notifications, and
# Auth sends password-reset emails.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (TLS from the start); false for 587 (STARTTLS).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# The sender: an address your SMTP server may send as, and the name shown.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CoDesignFlo
# true: accounts need no email confirmation (nothing proves an address, so invitations need their sign-up code).
# Set false once SMTP works: people confirm their address by email, invitations need no code, ALLOWED_DOMAINS works.
EMAIL_AUTOCONFIRM=true

############ Secrets (scripts/generate-keys.mjs fills these) ############

# The database's password (Postgres and the Supabase services' database roles). Letters and digits only: it goes
# into connection URLs. Set before the first start; changing it later needs the roles changed inside Postgres too.
POSTGRES_PASSWORD=
# Signs everyone's sign-in tokens and the two API keys below. At least 32 characters.
JWT_SECRET=
# The public API key (the anon role): browsers, the plugin and the CLI use it. Signed with JWT_SECRET.
ANON_KEY=
# The service role key: full access to the database, for the CoDesignFlo server only. Never share it.
SERVICE_ROLE_KEY=
# Shared by the database and the server: who may trigger sending notifications.
NOTIFY_SECRET=
# The code the box's first account signs up with (its admin). Keep it private until you've made that account.
SETUP_CODE=
# Realtime's own secrets: SECRET_KEY_BASE at least 64 characters, REALTIME_DB_ENC_KEY exactly 16.
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=

############ Optional ############

# How long a sign-in token lasts, in seconds (they renew themselves).
JWT_EXPIRY=3600
# Catch-up sends of waiting notifications, in minutes (the database also pings the server at once). 0 = off.
NOTIFY_EVERY_MINUTES=10
# Where designers install the Figma plugin (shown in invitations), and its Figma Community page.
PLUGIN_INSTALL_URL=
FIGMA_COMMUNITY_URL=
# The CoDesignFlo server: the published image (downloaded by `docker compose pull`; `latest` is the newest release,
# the same as this repository's newest commit; or pin a version: ghcr.io/orkestralai/codesignflo-server:0.6.5).
# Empty: build it from this checkout instead (`docker compose up -d --build`).
CODESIGNFLO_IMAGE=ghcr.io/orkestralai/codesignflo-server:latest
