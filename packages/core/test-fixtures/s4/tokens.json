{
  "color": {
    "$type": "color",
    "brand": {
      "primary": { "$value": "#4f46e5" },
      "primary-hover": { "$value": "#4338ca" }
    },
    "surface": {
      "default": { "$value": "#ffffff" },
      "muted": { "$value": "#f4f4f5" }
    },
    "text": {
      "primary": { "$value": "#18181b" },
      "secondary": { "$value": "#52525b" },
      "on-brand": { "$value": "#ffffff" }
    },
    "border": { "default": { "$value": "#e4e4e7" } },
    "status": {
      "sale": { "$value": "#dc2626" },
      "sale-surface": { "$value": "#fee2e2" }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "6": { "$value": "24px" }
  },
  "radius": {
    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "full": { "$value": "9999px" }
  },
  "font": {
    "family": { "$type": "fontFamily", "sans": { "$value": ["Inter", "sans-serif"] } },
    "size": {
      "$type": "dimension",
      "sm": { "$value": "12px" },
      "md": { "$value": "14px" },
      "lg": { "$value": "16px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    }
  }
}
