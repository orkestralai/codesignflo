{
  "name": "codesignflo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "typecheck": "pnpm --filter @codesignflo/core build && pnpm -r --filter './packages/*' typecheck",
    "test": "vitest run",
    "lint": "biome check packages service/mcp service/test",
    "format": "biome format --write packages",
    "plugin:pack": "pnpm --filter @codesignflo/plugin pack:zip && pnpm --filter @codesignflo/plugin build",
    "codesignflo": "pnpm --dir examples/demo-app codesignflo"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.0",
    "vitest": "^5.0.0"
  },
  "license": "SEE LICENSE IN LICENSE.md"
}
