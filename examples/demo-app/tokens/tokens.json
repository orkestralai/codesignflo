    },
    "border": { "default": { "$value": "#e4e4e7" } },
    "status": {
      "sale": { "$value": "#dc2626" },
      "sale-surface": { "$value": "#fee2e2" }
    },
    "tip": {
      "text": { "$value": "#000000" },
      "decoration": { "$value": "#e66633" }
    },
    "semantic": {
      "accent": { "ai": { "$value": "#7c3aed" } },
      "action": {
        "accent": { "$value": "#3b82f6" },
