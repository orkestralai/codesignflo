        "strong": { "$value": "#64748b" },
        "subtle": { "$value": "#e2e8f0" }
      },
      "status": {
        "success-text": { "$value": "#15803d" },
        "warning-background": { "$value": "#fef3c7" },
        "warning-text": { "$value": "#92400e" }
      },
      "surface": {
        "inverse": { "$value": "#0f172a" },
        "subtle": { "$value": "#f8fafc" }
      },
      "text": {
        "muted": { "$value": "#64748b" },
        "primary": { "$value": "#0f172a" },
        "secondary": { "$value": "#475569" }
      }
    }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "1-5": { "$value": "6px" },
    "2": { "$value": "8px" },
    "2-5": { "$value": "10px" },
