    "$type": "dimension",
    "sm": { "$value": "4px" },
    "md": { "$value": "8px" },
    "full": { "$value": "9999px" }
  },
  "font": {
    "family": { "$type": "fontFamily", "sans": { "$value": ["Inter", "sans-serif"] } },
    "size": {
      "$type": "dimension",
      "sm": { "$value": "12px" },
      "md": { "$value": "14px" },
      "lg": { "$value": "16px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 }
    }
  }
